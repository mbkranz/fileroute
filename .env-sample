# Legacy environment setup remains supported when no auth profile is selected.
# Copy only the settings needed for your provider into a private .env file.
# Never commit live secrets, downloaded credential files, or token caches.
# New reusable setup: fileroute auth configure NAME --provider sharepoint|gdrive|s3
# See docs/authentication.md and examples/auth/profiles.yaml.

# Optional profile directory (default: $XDG_CONFIG_HOME/fileroute or ~/.config/fileroute).
# Keep it private and outside the repository; set this at runtime for transfers.
# FILEROUTE_CONFIG_DIR=/absolute/private/path/fileroute
# XDG_CONFIG_HOME=/absolute/private/path/config

# Microsoft Graph app-only; delegated mode uses tenant/client and no client secret.
SHAREPOINT_AUTH_MODE=app_only
AZURE_TENANT_ID=YOUR_TENANT_ID
AZURE_CLIENT_ID=YOUR_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_CLIENT_SECRET
SHAREPOINT_HOST_URL=contoso.sharepoint.com
SHAREPOINT_SCOPES=https://graph.microsoft.com/.default
# AZURE_HOST_URL and AZURE_SCOPES are accepted legacy aliases.
# Named app-only profiles instead use client_secret_env: WORK_AZURE_CLIENT_SECRET.
# Supply that variable through the runtime or a secret manager.

# Google: choose adc, service_account, or user_oauth and uncomment its settings.
GOOGLE_AUTH_MODE=adc
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive
# ADC or explicit service-account file (paths here are legacy working-directory paths):
# GOOGLE_APPLICATION_CREDENTIALS=/secure/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=/secure/google-service-account.json
# Installed-app user OAuth:
# GOOGLE_OAUTH_CREDENTIALS=/secure/google-desktop.json
# GOOGLE_OAUTH_TOKEN_PATH=.google/oauth-token.json
GOOGLE_OAUTH_USE_LOCAL_SERVER=true

# S3 uses Boto3's native AWS credential chain, including roles and named profiles.
# Complete native AWS SSO login first when required; Fileroute does not store AWS keys.
# AWS_PROFILE=team-dev
